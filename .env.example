# =============================================================================
# ghbak configuration - copy to .env next to ghbak.sh, then: chmod 600 .env
#
# One KEY=value per line, comments on their own line. Do NOT quote values.
# =============================================================================

# Docker image (docker build -t ghbak:latest .)
IMAGE=ghbak:latest

# Backup directory (ghbak.sh run) and test directory (ghbak.sh test)
DATA_DIR=/mnt/backup/github
TEST_DATA_DIR=/mnt/backup/github-test

# Logs: history.log + one file per run
LOG_DIR=/srv/ghbak/logs

# If set, `run` refuses to start unless this path is a mount point.
# Protects the Pi's SD card when the USB disk is missing. Leave empty on a dev PC.
REQUIRE_MOUNT=/mnt/backup

# UID:GID the container runs as. Empty = the user running ghbak.sh.
# On Windows (Git Bash + Docker Desktop) empty means 0:0: git must chmod on the mounted folder.
RUN_AS=

# Time zone for log timestamps
TZ=Asia/Taipei

# GitHub username (not the e-mail address)
GITHUB_USER=your-github-username

# Fine-grained personal access token (github_pat_...), read-only:
#   Repository access = All repositories
#   Contents / Metadata / Issues / Pull requests / Webhooks = Read-only
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Options passed to github-backup (`docker run --rm ghbak:latest -h` lists all):
#   --all          repos, wikis, issues, PRs, labels, milestones, hooks (needs Webhooks permission)
#   --private      include private repos
#   --fork         include your forks
#   --bare         mirror clone (all branches and tags)
#   --incremental  issues/PRs: only fetch changes since the last run
#   --releases     release metadata (add --assets to also download release files)
#   --gists        your gists
#   --lfs          Git LFS objects
# --no-prune is always added by ghbak.sh: nothing deleted on GitHub is deleted here.
GHB_ARGS=--all --private --fork --bare --incremental --releases --gists --throttle-limit 100 --throttle-pause 60

# Repos for `ghbak.sh test` (space separated), e.g. one public + one private
TEST_REPOS=my-public-repo my-private-repo
